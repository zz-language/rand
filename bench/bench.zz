// bench.zz — throughput measurements. Run from bench/:
//   zz install && zz run bench.zz            # debug VM numbers
//   zz build bench.zz -o bench_aot && ./bench_aot   # AOT numbers
// Self-timing via std.time (ms resolution); N chosen so the VM leg
// finishes in seconds, not minutes.
import rand
import std.args
import std.time

// Iterations from argv (`zz run bench.zz -- 5000`), default 50000.
func arg_n() -> int {
    raw := args.get_raw()
    if raw.len() > 1 {
        return int(raw[1]) ?? 50000
    }
    return 50000
}

func main() {
    N := arg_n()
    rng := rand.seed(42)
    t0 := time.now_ms()
    i := 0
    while i < N {
        p := rand.u32(rng)
        rng = p[1]
        i += 1
    }
    t1 := time.now_ms()
    println("u32 {N} draws ms: {t1 - t0}")

    t0 = time.now_ms()
    i = 0
    while i < N {
        p := rand.randint(rng, 1, 100)
        rng = p[1]
        i += 1
    }
    t1 = time.now_ms()
    println("randint {N} draws ms: {t1 - t0}")

    t0 = time.now_ms()
    p := rand.fill(rng, N)
    rng = p[1]
    t1 = time.now_ms()
    println("fill {N} ms: {t1 - t0}")

    t0 = time.now_ms()
    q := rand.draw(rng, 1, 100, N)
    rng = q[1]
    t1 = time.now_ms()
    println("draw {N} ms: {t1 - t0}")

    xs:[int] = q[0]
    t0 = time.now_ms()
    s, rng := rand.shuffle(rng, xs)
    t1 = time.now_ms()
    println("shuffle {N} elems ms: {t1 - t0}")

    t0 = time.now_ms()
    m, rng := rand.sample(rng, xs, 100)
    t1 = time.now_ms()
    println("sample(100) ms: {t1 - t0}")
    println("shuffled: {s.len()} sampled-none: {m == .none}")
    println("bench_ok")
}
