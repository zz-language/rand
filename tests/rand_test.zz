// rand_test.zz — test suite for the rand package (pure, no I/O).
// Separate `rand-tests` package (`import rand`) so the published
// artifact stays lean. Run from tests/: `zz install && zz test`.
import rand

@test
func test_seed_is_deterministic() {
    a := rand.seed(42)
    b := rand.seed(42)
    x, a := rand.u32(a)
    y, b := rand.u32(b)
    assert_eq(x, y)
    assert_eq(a.s0, b.s0)
    assert_eq(a.s1, b.s1)
    assert_eq(a.s2, b.s2)
    assert_eq(a.s3, b.s3)
}

@test
func test_known_answer() {
    // xoshiro128++ reference vector (LCG-expanded seed 42).
    r := rand.seed(42)
    x, r := rand.u32(r)
    assert_eq(x, 3389691633)
    x, r := rand.u32(r)
    assert_eq(x, 594985917)
    x, r := rand.u32(r)
    assert_eq(x, 4134283714)
}

@test
func test_different_seeds_differ() {
    a := rand.seed(1)
    b := rand.seed(2)
    x, a := rand.u32(a)
    y, b := rand.u32(b)
    assert_ne(x, y)
}

@test
func test_below_stays_in_range() {
    r := rand.seed(7)
    i := 0
    while i < 500 {
        p := rand.below(r, 100)
        r = p[1]
        v := p[0]
        assert(v >= 0)
        assert(v < 100)
        i += 1
    }
}

@test
func test_below_one_always_zero() {
    r := rand.seed(7)
    v, r := rand.below(r, 1)
    assert_eq(v, 0)
}

@test
func test_f64_in_unit_interval() {
    r := rand.seed(7)
    i := 0
    while i < 200 {
        p := rand.f64(r)
        r = p[1]
        assert(p[0] >= 0.0)
        assert(p[0] < 1.0)
        i += 1
    }
}

@test
func test_shuffle_preserves_elements() {
    r := rand.seed(9)
    a := [1, 2, 3, 4, 5]
    p := rand.shuffle(r, a)
    s := p[0]
    assert_eq(s.len(), 5)
    // Same multiset: sums match and the input is untouched.
    total := 0
    for x in s {
        total += x
    }
    assert_eq(total, 15)
    assert_eq(a, [1, 2, 3, 4, 5])
}

@test
func test_pick_empty_is_none() {
    r := rand.seed(9)
    empty:[int] = []
    p := rand.pick(r, empty)
    assert(p[0] == .none)
}

@test
func test_state_threads() {
    // Drawing twice advances the stream (no repeated values in a row
    // for a healthy generator over a few draws).
    r := rand.seed(123)
    a, r := rand.u32(r)
    b, r := rand.u32(r)
    c, r := rand.u32(r)
    assert(a != b || b != c)
}

@test
func test_auto_seed_runs() {
    a := rand.auto_seed()
    x, a := rand.u32(a)
    assert(x >= 0)
}

@test
func test_randint_range() {
    r := rand.seed(11)
    i := 0
    while i < 300 {
        p := rand.randint(r, 5, 10)
        r = p[1]
        v := p[0]
        assert(v >= 5)
        assert(v < 10)
        i += 1
    }
}

@test
func test_randint_degenerate() {
    r := rand.seed(11)
    v, r := rand.randint(r, 7, 7)
    assert_eq(v, 7)
    w, r := rand.randint(r, 9, 3)
    assert_eq(w, 9)
}

@test
func test_randint_deterministic() {
    a := rand.seed(99)
    b := rand.seed(99)
    x, a := rand.randint(a, 1, 100)
    y, b := rand.randint(b, 1, 100)
    assert_eq(x, y)
}

@test
func test_uniform_bounds() {
    r := rand.seed(13)
    i := 0
    while i < 200 {
        p := rand.uniform(r, -5.0, 5.0)
        r = p[1]
        assert(p[0] >= -5.0)
        assert(p[0] <= 5.0)
        i += 1
    }
}

@test
func test_uniform_degenerate() {
    r := rand.seed(13)
    v, r := rand.uniform(r, 2.5, 2.5)
    assert_eq(v, 2.5)
}

@test
func test_choices_length_and_membership() {
    r := rand.seed(17)
    a := [10, 20, 30]
    p := rand.choices(r, a, 50)
    r = p[1]
    out := p[0]
    assert_eq(out.len(), 50)
    for x in out {
        assert(x == 10 || x == 20 || x == 30)
    }
}

@test
func test_choices_empty() {
    r := rand.seed(17)
    empty:[int] = []
    p := rand.choices(r, empty, 5)
    assert_eq(p[0].len(), 0)
}

@test
func test_sample_no_repeats() {
    r := rand.seed(19)
    a := [1, 2, 3, 4, 5]
    p := rand.sample(r, a, 3)
    r = p[1]
    s := p[0] ?? []
    assert_eq(s.len(), 3)
    // Distinct: every pair differs; every element comes from the input.
    i := 0
    while i < 3 {
        j := i + 1
        while j < 3 {
            assert_ne(s[i], s[j])
            j += 1
        }
        assert(s[i] >= 1)
        assert(s[i] <= 5)
        i += 1
    }
}

@test
func test_sample_all_and_none() {
    r := rand.seed(19)
    a := [1, 2, 3]
    p := rand.sample(r, a, 5)
    assert(p[0] == .none)
    q := rand.sample(r, a, 3)
    s := q[0] ?? []
    assert_eq(s.len(), 3)
    assert_eq(s[0] + s[1] + s[2], 6)
}

@test
func test_sample_zero() {
    r := rand.seed(19)
    p := rand.sample(r, [1, 2], 0)
    assert_eq(p[0] ?? [9], [])
}

@test
func test_weighted_certain_pick() {
    r := rand.seed(23)
    a := [10, 20]
    w := [1.0, 0.0]
    i := 0
    while i < 20 {
        p := rand.choices_weighted(r, a, w, 1)
        r = p[1]
        s := p[0] ?? []
        assert_eq(s.len(), 1)
        assert_eq(s[0], 10)
        i += 1
    }
}

@test
func test_weighted_proportions() {
    r := rand.seed(23)
    a := [0, 1]
    w := [3.0, 1.0]
    zeros := 0
    i := 0
    while i < 200 {
        p := rand.choices_weighted(r, a, w, 1)
        r = p[1]
        s := p[0] ?? []
        zeros += 1 - s[0]
        i += 1
    }
    // E[zeros] = 150, sd ~= 6.1: [120, 180] is ~5sd each way.
    assert(zeros > 120)
    assert(zeros < 180)
}

@test
func test_weighted_rejects_bad_input() {
    r := rand.seed(23)
    a := [1, 2]
    p := rand.choices_weighted(r, a, [1.0], 1)
    assert(p[0] == .none)
    q := rand.choices_weighted(r, a, [1.0, -1.0], 1)
    assert(q[0] == .none)
    s := rand.choices_weighted(r, a, [0.0, 0.0], 1)
    assert(s[0] == .none)
    empty:[int] = []
    t := rand.choices_weighted(r, empty, [], 1)
    assert(t[0] == .none)
}

@test
func test_gauss_deterministic() {
    a := rand.seed(29)
    b := rand.seed(29)
    x, a := rand.gauss(a, 0.0, 1.0)
    y, b := rand.gauss(b, 0.0, 1.0)
    assert_eq(x, y)
}

@test
func test_gauss_degenerate() {
    r := rand.seed(29)
    v, r := rand.gauss(r, 2.5, 0.0)
    assert_eq(v, 2.5)
}

@test
func test_gauss_shape() {
    r := rand.seed(29)
    sum := 0.0
    sumsq := 0.0
    n := 60
    i := 0
    while i < n {
        p := rand.gauss(r, 10.0, 2.0)
        r = p[1]
        sum += p[0]
        sumsq += p[0] * p[0]
        i += 1
    }
    mean := sum / 60.0
    assert(mean > 9.0)
    assert(mean < 11.0)
    variance := sumsq / 60.0 - mean * mean
    assert(variance > 1.5)
    assert(variance < 8.0)
}

@test
func test_fill_matches_sequential() {
    a := rand.seed(31)
    b := rand.seed(31)
    p := rand.fill(a, 5)
    seq:[int] = []
    i := 0
    while i < 5 {
        q := rand.u32(b)
        b = q[1]
        seq.push(q[0])
        i += 1
    }
    assert_eq(p[0], seq)
}

@test
func test_fill_empty() {
    r := rand.seed(31)
    p := rand.fill(r, 0)
    assert_eq(p[0], [])
    q := rand.fill(r, -3)
    assert_eq(q[0], [])
}

@test
func test_methods_match_free_funcs() {
    a := rand.seed(77)
    b := rand.seed(77)
    x, a := a.randint(1, 100)
    y, b := rand.randint(b, 1, 100)
    assert_eq(x, y)
    assert_eq(a.s0, b.s0)
    assert_eq(a.s3, b.s3)
    f, a := a.f64()
    g, b := rand.f64(b)
    assert_eq(f, g)
    assert_eq(a.s0, b.s0)
    c, a := a.boolean()
    d, b := rand.boolean(b)
    assert_eq(c, d)
    assert_eq(a.s0, b.s0)
}

@test
func test_methods_generic() {
    r := rand.seed(78)
    p, r := r.pick([10, 20, 30])
    match p {
        .some(v) => assert(v >= 10 && v <= 30)
        .none => assert(false)
    }
    s, r := r.shuffle([1, 2, 3, 4])
    assert_eq(s.len(), 4)
    t, r := r.sample([1, 2, 3], 2)
    match t {
        .some(xs) => assert_eq(xs.len(), 2)
        .none => assert(false)
    }
}

@test
func test_draw_matches_sequential() {
    a := rand.seed(79)
    b := rand.seed(79)
    p := rand.draw(a, 5, 15, 6)
    a = p[1]
    seq:[int] = []
    i := 0
    while i < 6 {
        q := rand.randint(b, 5, 15)
        b = q[1]
        seq.push(q[0])
        i += 1
    }
    assert_eq(p[0], seq)
    assert_eq(a.s0, b.s0)
}

@test
func test_draw_degenerate() {
    r := rand.seed(79)
    assert_eq(rand.draw(r, 1, 10, 0)[0], [])
    assert_eq(rand.draw(r, 1, 10, -2)[0], [])
    assert_eq(rand.draw(r, 7, 7, 3)[0], [7, 7, 7])
    assert_eq(rand.draw(r, 9, 3, 2)[0], [9, 9])
}

@test
func test_draw_stays_in_range() {
    r := rand.seed(80)
    p := rand.draw(r, -5, 5, 300)
    got := p[0]
    for v in got {
        assert(v >= -5)
        assert(v < 5)
    }
}

@test
func test_quick_int_stays_in_range() {
    i := 0
    while i < 200 {
        v := rand.quick_int(1, 11)
        assert(v >= 1)
        assert(v < 11)
        i += 1
    }
}
